# --- Datenbank (PostgreSQL 16) ------------------------------------------------
# Migrationen laufen als Tabellen-Owner (darf DDL), die API als eingeschränkte Rolle ohne BYPASSRLS.
DATABASE_URL_MIGRATOR=postgres://isms_migrator:isms_migrator@localhost:5432/isms
DATABASE_URL=postgres://isms_app:isms_app@localhost:5432/isms
DATABASE_URL_TEST=postgres://isms_migrator:isms_migrator@localhost:5432/isms_test

# --- API ----------------------------------------------------------------------
API_PORT=3000
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173
# mind. 32 Zeichen; in Produktion aus Secret-Store
JWT_SECRET=change-me-in-production-change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Schlüssel für die Verschlüsselung von Integrations-Secrets (pgcrypto), 32 Bytes base64
APP_MASTER_KEY=change-me-change-me-change-me-change-me-12345=

# --- Dateien ------------------------------------------------------------------
# local | s3 (MinIO / Azure Blob via S3-kompatiblem Gateway) | azure
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/files

# --- E-Mail (Mailpit lokal) ---------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=isms@localhost
