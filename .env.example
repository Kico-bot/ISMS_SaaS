# --- Datenbank (PostgreSQL 16) ------------------------------------------------
# Migrationen laufen als Tabellen-Owner (darf DDL), die API als eingeschränkte Rolle ohne BYPASSRLS.
DATABASE_URL_MIGRATOR=postgres://isms_migrator:isms_migrator@localhost:5432/isms
DATABASE_URL=postgres://isms_app:isms_app@localhost:5432/isms
DATABASE_URL_TEST=postgres://isms_migrator:isms_migrator@localhost:5432/isms_test

# --- API ----------------------------------------------------------------------
API_PORT=3000
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173
# mind. 32 Zeichen; in Produktion aus Secret-Store
JWT_SECRET=change-me-in-production-change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Schlüssel für die Verschlüsselung von Integrations-Secrets (pgcrypto), 32 Bytes base64
APP_MASTER_KEY=change-me-change-me-change-me-change-me-12345=

# --- Dateien ------------------------------------------------------------------
# local | s3 (MinIO / Azure Blob via S3-kompatiblem Gateway) | azure
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/files

# --- E-Mail -------------------------------------------------------------------
# log  = nichts wird zugestellt, jede Nachricht landet im Protokoll und im Postausgang
#        der Anwendung. Standard: die Anwendung läuft ohne SMTP-Entscheidung.
# smtp = tatsächliche Zustellung über den unten konfigurierten Server.
MAIL_DRIVER=log
SMTP_HOST=localhost
# 1025 = Mailpit lokal; ein echter Server meist 587 (STARTTLS) oder 465 (SMTP_SECURE=true)
SMTP_PORT=1025
SMTP_SECURE=false
# leer lassen, wenn der Server ohne Anmeldung zustellt (Mailpit, interner Relay)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=isms@localhost

# --- Hintergrundaufträge (pg-boss, Warteschlange in derselben Datenbank) -------
# Nur im Worker-Prozess einschalten: pnpm --filter @isms/api worker
JOBS_ENABLED=false
# Werktags 7:00 Europe/Berlin — die tägliche Wiedervorlage je verantwortlicher Person.
# In Anführungszeichen, damit sich die Datei auch mit `set -a; . .env` einlesen lässt.
DIGEST_CRON="0 7 * * 1-5"
# Wie weit die Erinnerung vorausschaut (Tage).
DIGEST_HORIZON_DAYS=14
