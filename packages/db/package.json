{
  "name": "@isms/db",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle-Schema, SQL-Migrationen (inkl. RLS, Trigger, Views) und Seed-Runner",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo skip",
    "generate": "drizzle-kit generate",
    "migrate": "node dist/cli/migrate.js",
    "seed": "node dist/cli/seed.js",
    "reset": "node dist/cli/reset.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@isms/catalog": "workspace:*",
    "@isms/shared": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "pg": "^8.13.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
